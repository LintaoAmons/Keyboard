{
  "version": "0.1",
  "keyboardLayout": {
    "name": "Lintao's keyboard",
    "layout": [
      [ "esc", "1", "2", "3", "4", "5", "6", "7", "8", "9", "0", "-", "=", "|,grow" ],
      [ "tab,3", "q", "w", "e", "r", "t", "y", "u", "i", "o", "p", "[", "]", "<--,grow" ],
      [ "ctrl,4", "a", "s", "d", "f", "g", "h", "j", "k", "l", ";", "'", "enter,grow" ],
      [ "shift,5", "z", "x", "c", "v", "b", "n", "m", ",", ".", "/", "shift,grow" ],
      [ "", "", "alt", "cmd", "space,14", "hyper", "alt" ]
    ]
  },
  "name": "Vim Keybinding Generated",
  "scenarios": [
    {
      "name": "Vim Generated",
      "keymapItems": [
        "<leader>,t,h|Colorscheme Picker",
        "<leader>,s,s|Jump to LSP symbol",
        "<leader>,e,e|<Cmd>Yazi<CR>",
        "<leader>,f,l|<Cmd>Neotree reveal reveal_force_cwd<CR>",
        "<leader>,n,l|<Cmd>nohlsearch<CR>",
        "<leader>,w,s|<Cmd>split<CR>",
        "%|<Plug>(MatchitNormalForward)",
        "&|:help &-default",
        "Y|:help Y-default",
        "g,t|<Cmd>Lspsaga goto_type_definition<CR>",
        "g,r,a|vim.lsp.buf.code_action()",
        "g,r,n|vim.lsp.buf.rename()",
        "g,c,c|Comment line",
        "g,c|Comment",
        "g,x|Opens filepath or URI under cursor with the system handler (file explorer, web browser, …)",
        "j|gj",
        "k|gk",
        "m,o|Go to bookmark",
        "m,s|Show current bookmark info",
        "m,a|Open bookmarks commands",
        "m,m|Toggle bookmark at current line",
        "<C-D-h>|Decrease window width",
        "<C-D-l>|Increase window width",
        "<C-k>|:<C-U>TmuxNavigateUp<CR>",
        "<C-j>|:<C-U>TmuxNavigateDown<CR>",
        "<C-h>|:<C-U>TmuxNavigateLeft<CR>",
        "<C-l>|:<C-U>TmuxNavigateRight<CR>",
        "<D-1>|ExplorerToggle",
        "<D-q>|<Cmd>qa!<CR>",
        "<C-w>,d|Show diagnostics under the cursor"
      ]
    }
  ]
}
