        "<C-d>|delete target terminal|TerminalPicker|waiting-for-dev/ergoterm.nvim",

        "space,s,l|Send current line to last focused terminal|n|waiting-for-dev/ergoterm.nvim",
        "space,s,k|Send selected text to last focused terminal|n|waiting-for-dev/ergoterm.nvim",
        "space,s,o|Cd to buffer directory in the last focused terminal|n|waiting-for-dev/ergoterm.nvim",
